rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Full ticket data: purchase price, sold price, buyer, transfers.
    // Only the signed-in owner account can read or write this at all.
    match /tickets/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == "0YFoREzumkQSjDHScBmi4Vo3WxR2";
    }

    // Public listing: date, opponent, seat, tier, market price, sold flag only.
    // Anyone can read it (that's the customer-facing page).
    // Only the owner account can write to it.
    match /listings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "0YFoREzumkQSjDHScBmi4Vo3WxR2";
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
